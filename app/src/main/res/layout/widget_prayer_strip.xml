<?xml version="1.0" encoding="utf-8"?>
<!--
    The one-row strip widget: five prayers across a single cell of home screen.

    Four lines per column — icon, name, Adhan time, countdown — each on its own line. Measured on
    the target device a 5x1 placement is 406dp x 96dp, which leaves room for all four at legible
    sizes; the earlier three-line version left roughly forty of those ninety-six vertical dp empty.

    Columns are weighted rather than fixed, so the strip fills whatever width it is given.
    `gravity="top"` on the row matters: the countdown line is present in every column but empty in
    the passed ones, and without it the short columns would centre against the tall ones and the
    times would stop forming a line.

    The hardcoded values are placeholders that also serve as the widget picker's preview, which
    inflates this file without ever running the binder. Every one is overwritten by StripWidgetViews.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/strip_columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:gravity="top">

        <LinearLayout
            android:id="@+id/strip_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/strip_0_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_prayer_fajr"
                android:contentDescription="@string/prayer_fajr" />

            <TextView
                android:id="@+id/strip_0_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textSize="12sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/strip_0_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:34 am"
                android:textSize="15sp"
                android:textColor="@color/widget_ink"
                android:maxLines="1" />

            <!-- Still countdown and ticking countdown occupy the same line; exactly one shows. -->
            <TextView
                android:id="@+id/strip_0_still"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3h"
                android:textSize="13sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1" />

            <Chronometer
                android:id="@+id/strip_0_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_accent"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/strip_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/strip_1_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_prayer_dhuhr"
                android:contentDescription="@string/prayer_dhuhr" />

            <TextView
                android:id="@+id/strip_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dhuhr"
                android:textSize="12sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/strip_1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:23 pm"
                android:textSize="15sp"
                android:textColor="@color/widget_ink"
                android:maxLines="1" />

            <!-- Still countdown and ticking countdown occupy the same line; exactly one shows. -->
            <TextView
                android:id="@+id/strip_1_still"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7h"
                android:textSize="13sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1" />

            <Chronometer
                android:id="@+id/strip_1_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_accent"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/strip_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/strip_2_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_prayer_asr"
                android:contentDescription="@string/prayer_asr" />

            <TextView
                android:id="@+id/strip_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asr"
                android:textSize="12sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/strip_2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3:49 pm"
                android:textSize="15sp"
                android:textColor="@color/widget_ink"
                android:maxLines="1" />

            <!-- Still countdown and ticking countdown occupy the same line; exactly one shows. -->
            <TextView
                android:id="@+id/strip_2_still"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10h"
                android:textSize="13sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1" />

            <Chronometer
                android:id="@+id/strip_2_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_accent"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/strip_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/strip_3_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_prayer_maghrib"
                android:contentDescription="@string/prayer_maghrib" />

            <TextView
                android:id="@+id/strip_3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:textSize="12sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/strip_3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6:48 pm"
                android:textSize="15sp"
                android:textColor="@color/widget_ink"
                android:maxLines="1" />

            <!-- Still countdown and ticking countdown occupy the same line; exactly one shows. -->
            <TextView
                android:id="@+id/strip_3_still"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13h"
                android:textSize="13sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1" />

            <Chronometer
                android:id="@+id/strip_3_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_accent"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/strip_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/strip_4_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_prayer_isha"
                android:contentDescription="@string/prayer_isha" />

            <TextView
                android:id="@+id/strip_4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Isha"
                android:textSize="12sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/strip_4_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:04 pm"
                android:textSize="15sp"
                android:textColor="@color/widget_ink"
                android:maxLines="1" />

            <!-- Still countdown and ticking countdown occupy the same line; exactly one shows. -->
            <TextView
                android:id="@+id/strip_4_still"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15h"
                android:textSize="13sp"
                android:textColor="@color/widget_ink_muted"
                android:maxLines="1" />

            <Chronometer
                android:id="@+id/strip_4_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_accent"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/strip_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="@color/widget_ink_muted"
        android:visibility="gone" />
</FrameLayout>
