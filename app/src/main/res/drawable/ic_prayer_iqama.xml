        android:fillColor="#FFFFFFFF"
        android:pathData="M12,4.6a3.8,3.8 0 0,1 3.8,3.8v2.2h-7.6v-2.2a3.8,3.8 0 0,1 3.8,-3.8z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6.8,12.2h10.4v7.4h-10.4z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2.6,10.4h2.2v9.2h-2.2zM19.2,10.4h2.2v9.2h-2.2z" />
