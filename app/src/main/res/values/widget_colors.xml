<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget's palette.

    Separate from the app's `PrayerPalette` for a reason worth stating: a widget is drawn by the
    launcher, not by this app, so it cannot read the in-app theme preference. It follows the system
    night setting through `values-night/` and nothing else. A user who has forced the app to Light
    while the system is Dark will see a dark widget, which is the correct behaviour for a surface
    that has to sit alongside every other widget on the same wallpaper.

    Values match PrayerColors.kt so the two surfaces still look like one product.
-->
<resources>
    <color name="widget_background">#FFF7F4EC</color>
    <color name="widget_ink">#FF15181F</color>
    <color name="widget_ink_muted">#FF5A6172</color>
    <color name="widget_ink_faint">#FF8D93A3</color>
    <color name="widget_line">#FFDED8C9</color>
    <color name="widget_accent">#FF8A6100</color>
    <color name="widget_row_highlight">#FFEFEADD</color>

    <!-- Deeper than the dark theme's, to keep contrast against a pale ground. -->
    <color name="widget_iqama">#FFC2410C</color>
</resources>
